# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Production Configuration:
# Set your Supabase Project URL and Public Anon Key in your deployment platform's environment settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Supabase Service Role Key for server-side administrative password updates
SUPABASE_SERVICE_ROLE_KEY=

# Email Configuration for Password Reset Codes (Optional: SMTP or Resend)
# SMTP configuration (e.g. institutional email, Gmail with App Password, SendGrid, Brevo, Mailgun):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Maltese Archive <noreply@tua.edu.ph>"
SMTP_SECURE=false

# Alternatively, Resend API key:
RESEND_API_KEY=


